---
/** Filters demo: dependent selects + filtered results. */
import FilterControls from '../FilterControls.astro';
import FilterResults from '../FilterResults.astro';
---

<section
  class="demo"
  data-signals="{type: '', region: '', destination: '', limit: '5'}"
>
  <h2>Find an experience</h2>
  <FilterControls region="" />
  <FilterResults type="" region="" destination="" limit={5} />
</section>

<style>
  :global(.filter-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  :global(.filter-grid select) {
    font: inherit;
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--panel);
  }
</style>
