---
interface Props {
  /** Plugin module name under packages/astro-datastar/src/plugins/. */
  name: string;
}

const { name } = Astro.props;

// Bundle the real plugin sources so the demo can never drift from them.
const sources: Record<string, string> = {
  ...import.meta.glob<string>('../datastar/plugins/*.ts', {
    query: '?raw',
    import: 'default',
    eager: true,
  }),
  ...import.meta.glob<string>(
    '../../../packages/astro-datastar/src/plugins/*.ts',
    { query: '?raw', import: 'default', eager: true },
  ),
};

const entry = Object.entries(sources).find(([path]) =>
  path.endsWith(`/${name}.ts`),
);
if (!entry) throw new Error(`Unknown plugin source: ${name}`);
const source = entry[1].trim();
---

<details class="plugin-source">
  <summary>Plugin source: <code>plugins/{name}.ts</code></summary>
  <pre><code>{source}</code></pre>
</details>

<style>
  .plugin-source {
    margin-top: 1rem;
  }
  .plugin-source summary {
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .plugin-source summary:hover {
    color: var(--accent);
  }
  .plugin-source pre {
    max-height: 28rem;
    overflow: auto;
  }
</style>
