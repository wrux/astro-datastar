---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const quickStart = `// astro.config.mjs
import { defineConfig } from 'astro/config';
import datastar from '@wrux/astro-datastar';

export default defineConfig({
  integrations: [datastar()],
});`;

const endpoint = `import { html, readSignals } from '@wrux/astro-datastar/server';

export const GET: APIRoute = async ({ request }) => {
  const { q } = await readSignals<{ q: string }>(request);
  const container = await AstroContainer.create();
  return html(await container.renderToString(SearchResults, { props: { q } }));
};`;
---

<Layout title="Astro + Datastar">
  <p>
    <a href="https://github.com/wrux/astro-datastar"><code>@wrux/astro-datastar</code></a> is
    an <a href="https://astro.build">Astro</a> integration
    for <a href="https://data-star.dev">Datastar</a> v1.0.2 (vendored bundle —
    no CDN request), plus server helpers for answering Datastar requests from
    Astro endpoints and a minimal <code>data-replace-url</code> plugin.
  </p>
  <p>
    Reactive <em>signals</em> declared in HTML attributes
    (<code>data-signals</code>, <code>data-bind:*</code>, <code>data-text</code>, <code>data-show</code>…)
    plus backend actions
    (<code>@get</code>, <code>@post</code>…) whose HTML responses are morphed
    into the page by element id. No client framework, no islands — the
    server renders Astro components, Datastar patches them in.
  </p>

  <h2>Quick start</h2>
  <CodeBlock code={quickStart} lang="js" title="astro.config.mjs" />
  <CodeBlock code={endpoint} lang="ts" title="src/pages/api/search.ts" />

  <h2>Where next</h2>
  <ul>
    <li>
      <a href="/docs/installation">Docs</a> — installation, integration
      options, reading signals, server responses, validation, loading
      states, and writing plugins.
    </li>
    <li>
      <a href="/examples/signals">Examples</a> — live demos of signals,
      search, pagination, load more, filters, forms, polling, and streaming.
    </li>
    <li>
      <a href="/examples/plugins/collapse">Plugin examples</a> — custom
      plugins (collapse, cloak, combobox) written in this app on top of the
      package's engine export.
    </li>
  </ul>
</Layout>
