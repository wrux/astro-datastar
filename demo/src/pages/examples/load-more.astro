---
import Layout from '../../layouts/Layout.astro';
import EntryBatch from '../../components/EntryBatch.astro';
import { entries } from '../../data/entries';

// Deep link: ?offset=… server-renders everything already loaded.
export const prerender = false;
const LIMIT = 5;
const raw = Number(Astro.url.searchParams.get('offset')) || LIMIT;
const offset = Math.min(
  Math.max(LIMIT, Math.ceil(raw / LIMIT) * LIMIT),
  Math.ceil(entries.length / LIMIT) * LIMIT,
);
const done = offset >= entries.length;
---

<Layout title="Load more">
  <p>
    The button sends the current <code>$offset</code>; the endpoint answers with
    three SSE events: <code>patchElements</code> (mode <code>append</code>)
    adds the next batch to <code>#entries</code>, <code>patchSignals</code>
    advances the offset, and — once everything is loaded —
    <code>removeElements('#load-more-button')</code> takes the button away.
  </p>

  <section
    class="demo"
    data-signals={`{offset: ${offset}}`}
    data-replace-url={`'/examples/load-more' + ($offset > ${LIMIT} ? '?offset=' + $offset : '')`}
  >
    <h2>Walks ({entries.length})</h2>
    <ul id="entries" class="entry-list">
      <EntryBatch offset={0} limit={offset} />
    </ul>
    {
      !done && (
        <div id="load-more-button">
          <button
            data-on:click="@get('/api/load-more')"
            data-indicator="_loading"
            data-attr:disabled="$_loading"
          >
            Load more
          </button>
        </div>
      )
    }
    <pre><code>&lt;!-- page (?offset=15 deep-links; replace-url tracks the patched $offset) --&gt;
&lt;section data-signals="&lbrace;offset: &lbrace;offset&rbrace;&rbrace;"
         data-replace-url="'/examples/load-more' + ($offset &gt; 5 ? '?offset=' + $offset : '')"&gt;
  &lt;ul id="entries"&gt;&lt;EntryBatch offset=&lbrace;0&rbrace; /&gt;&lt;/ul&gt;
  &lt;div id="load-more-button"&gt;
    &lt;button data-on:click="@get('/api/load-more')"&gt;Load more&lt;/button&gt;
  &lt;/div&gt;
&lt;/section&gt;

&lt;!-- endpoint --&gt;
return sse(
  patchElements(batch, &lbrace; selector: '#entries', mode: 'append' &rbrace;),
  patchSignals(&lbrace; offset: nextOffset &rbrace;),
  ...(done ? [removeElements('#load-more-button')] : []),
);</code></pre>
  </section>
</Layout>
