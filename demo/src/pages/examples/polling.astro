---
import Layout from '../../layouts/Layout.astro';
import ServerTime from '../../components/ServerTime.astro';
---

<Layout title="Polling">
  <p>
    <code>data-init</code> fetches once on load and
    <code>data-on-interval__duration.5s</code> re-fetches every five seconds.
    The endpoint just renders <code>&lt;div id="server-time"&gt;</code>; the
    morph swaps it in place.
  </p>

  <section class="demo">
    <h2>Server clock</h2>
    <div
      data-init="@get('/api/time')"
      data-on-interval__duration.5s="@get('/api/time')"
    >
      <ServerTime />
    </div>
    <pre><code>&lt;div data-init="@get('/api/time')"
     data-on-interval__duration.5s="@get('/api/time')"&gt;
  &lt;div id="server-time"&gt;Loading…&lt;/div&gt;
&lt;/div&gt;</code></pre>
  </section>

  <section class="demo">
    <h2>Re-fetch by convention</h2>
    <p>
      <code>data-on:*</code> listens for any DOM event, so re-fetching is a
      convention rather than a plugin: give a region
      <code>data-on:refetch="@get(…)"</code> and dispatch a bubbling
      <code>CustomEvent('refetch')</code> at it from anywhere.
    </p>
    <div data-on:refetch="@get('/api/time')">
      <button data-on:click="evt.target.dispatchEvent(new CustomEvent('refetch', {bubbles: true}))">
        Refresh now
      </button>
    </div>
    <pre><code>&lt;div data-on:refetch="@get('/api/time')"&gt;
  &lt;button data-on:click="evt.target.dispatchEvent(new CustomEvent('refetch', &lbrace;bubbles: true&rbrace;))"&gt;
    Refresh now
  &lt;/button&gt;
&lt;/div&gt;</code></pre>
  </section>
</Layout>
