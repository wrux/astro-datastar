---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout title="Form validation">
  <p>
    The form is <code>novalidate</code> — no native HTML validation. The real
    rules live in a Zod schema on the server. <code>@post(…,
    {'{'}contentType: 'form'{'}'})</code> submits the fields as form data;
    on failure the endpoint re-renders the same
    <code>&lt;ContactForm/&gt;</code> component with the submitted values and
    per-field errors (<code>aria-invalid</code> +
    <code>aria-describedby</code> wired up), and on success it re-renders it
    in the thanks state. One component, three states, written once.
  </p>

  <section class="demo">
    <h2>Contact form</h2>
    <ContactForm />
    <pre><code>&lt;!-- page + every server response render the same component --&gt;
&lt;form novalidate data-on:submit="@post('/api/contact', &lbrace;contentType: 'form'&rbrace;)"&gt;…&lt;/form&gt;

&lt;!-- endpoint --&gt;
const contact = z.object(&lbrace;
  name: z.string().trim().min(2, 'Please give your name…'),
  email: z.string().trim().email('That email address doesn’t look right.'),
  message: z.string().trim().min(10, '…').max(500, '…'),
&rbrace;);

const raw = await readSignals(request);          // raw, so values survive
const result = contact.safeParse(raw);
if (!result.success) &lbrace;
  return html(await container.renderToString(ContactForm, &lbrace; props: &lbrace;
    values: raw,
    errors: result.error.flatten().fieldErrors,  // per-field messages
  &rbrace; &rbrace;));
&rbrace;
return html(await container.renderToString(ContactForm, &lbrace; props: &lbrace;
  values: result.data, success: true,
&rbrace; &rbrace;));</code></pre>
    <p class="hint">
      Try submitting empty, or with a bad email — the errors come back from
      the server as a morphed fragment, values intact.
    </p>
  </section>
</Layout>
