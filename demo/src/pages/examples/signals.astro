---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Signals & bindings">
  <p>
    Everything here is plain HTML — no endpoint involved. Signals live in
    <code>data-signals</code>, expressions reference them with
    <code>$name</code>.
  </p>

  <section class="demo" data-signals="{count: 0}">
    <h2>Counter</h2>
    <div class="row">
      <button data-on:click="$count--">−</button>
      <strong data-text="$count">0</strong>
      <button data-on:click="$count++">+</button>
      <button data-on:click="$count = 0">Reset</button>
    </div>
    <pre><code>&lt;section data-signals="&lbrace;count: 0&rbrace;"&gt;
  &lt;button data-on:click="$count--"&gt;−&lt;/button&gt;
  &lt;strong data-text="$count"&gt;0&lt;/strong&gt;
  &lt;button data-on:click="$count++"&gt;+&lt;/button&gt;
&lt;/section&gt;</code></pre>
  </section>

  <section class="demo" data-signals="{name: ''}">
    <h2>Two-way binding + computed</h2>
    <div data-computed:greeting="$name ? `Hello, ${$name}!` : 'Type your name…'">
      <label for="name">Name</label>
      <input id="name" type="text" data-bind:name placeholder="Ada" />
      <p data-text="$greeting"></p>
    </div>
    <pre><code>&lt;div data-computed:greeting="$name ? `Hello, $&lbrace;$name&rbrace;!` : 'Type your name…'"&gt;
  &lt;input data-bind:name /&gt;
  &lt;p data-text="$greeting"&gt;&lt;/p&gt;
&lt;/div&gt;</code></pre>
  </section>

  <section class="demo" data-signals="{open: false}">
    <h2>Show / hide + attributes</h2>
    <div class="row">
      <button
        data-on:click="$open = !$open"
        data-attr:aria-expanded="$open ? 'true' : 'false'"
        data-text="$open ? 'Hide details' : 'Show details'"
      >
        Show details
      </button>
    </div>
    <p data-show="$open" data-cloak>
      Revealed by <code>data-show="$open"</code>. The <code>data-cloak</code>
      attribute keeps this hidden until Datastar boots, so there is no flash
      of un-hidden content.
    </p>
    <pre><code>&lt;button data-on:click="$open = !$open"
        data-attr:aria-expanded="$open ? 'true' : 'false'"&gt;…&lt;/button&gt;
&lt;p data-show="$open" data-cloak&gt;…&lt;/p&gt;</code></pre>
  </section>

  <section class="demo" data-signals="{tab: 'a'}">
    <h2>Class toggling</h2>
    <div class="row" role="tablist" aria-label="Class toggling demo">
      <button role="tab" data-on:click="$tab = 'a'" data-class:active="$tab === 'a'">Tab A</button>
      <button role="tab" data-on:click="$tab = 'b'" data-class:active="$tab === 'b'">Tab B</button>
    </div>
    <p data-show="$tab === 'a'">Panel A</p>
    <p data-show="$tab === 'b'" data-cloak>Panel B</p>
    <pre><code>&lt;button data-on:click="$tab = 'a'" data-class:active="$tab === 'a'"&gt;Tab A&lt;/button&gt;</code></pre>
  </section>

  <style>
    button.active {
      border-color: var(--accent);
      color: var(--accent);
      font-weight: 600;
    }
  </style>
</Layout>
