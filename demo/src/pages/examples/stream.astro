---
import Layout from '../../layouts/Layout.astro';
import JobLog from '../../components/JobLog.astro';
---

<Layout title="SSE streaming">
  <p>
    One <code>@get</code> — many updates. The endpoint keeps the response
    open with <code>sseStream()</code> and pushes
    <code>patchSignals()</code> (progress %) and <code>patchElements()</code>
    (appended log lines) as work happens.
  </p>

  <section class="demo" data-signals="{progress: 0, running: false}">
    <h2>Long-running job</h2>
    <div class="row">
      <button
        data-on:click="@get('/api/stream')"
        data-attr:disabled="$running"
        data-text="$running ? 'Working…' : 'Start job'"
      >
        Start job
      </button>
      <span data-text="$progress + '%'">0%</span>
    </div>
    <progress max="100" data-attr:value="$progress"></progress>
    <JobLog />
    <pre><code>// client
&lt;section data-signals="&lbrace;progress: 0, running: false&rbrace;"&gt;
  &lt;button data-on:click="@get('/api/stream')" data-attr:disabled="$running"&gt;Start&lt;/button&gt;
  &lt;progress max="100" data-attr:value="$progress"&gt;&lt;/progress&gt;
  &lt;ul id="job-log"&gt;&lt;/ul&gt;
&lt;/section&gt;

// server (src/pages/api/stream.ts)
return sseStream(async (stream) =&gt; &lbrace;
  stream.send(patchSignals(&lbrace; running: true, progress: 0 &rbrace;));
  for (const [i, step] of steps.entries()) &lbrace;
    await sleep(500);
    stream.send(patchSignals(&lbrace; progress: … &rbrace;));
    stream.send(patchElements(`&lt;li&gt;$&lbrace;step&rbrace;&lt;/li&gt;`, &lbrace;
      selector: '#job-log', mode: 'append',
    &rbrace;));
  &rbrace;
  stream.send(patchSignals(&lbrace; running: false &rbrace;));
&rbrace;);</code></pre>
  </section>
</Layout>
