---
import Layout from '../../layouts/Layout.astro';
import PaginatedEntries from '../../components/PaginatedEntries.astro';
import PluginSource from '../../components/PluginSource.astro';
import { entries } from '../../data/entries';

// Deep link: ?page=… server-renders that page; replace-url keeps it in sync.
export const prerender = false;
const LIMIT = 5;
const maxOffset = (Math.ceil(entries.length / LIMIT) - 1) * LIMIT;
const page = Number(Astro.url.searchParams.get('page')) || 1;
const offset = Math.min(Math.max(0, (page - 1) * LIMIT), maxOffset);
---

<Layout title="Pagination">
  <p>
    Prev/next buttons bake their target offset in server-side, so a click just
    sets <code>$offset</code> and re-fetches. The endpoint re-renders the
    whole <code>#pagination</code> region — list, buttons (with correct
    disabled states), and page info — with the same Astro component the page
    used for the initial render.
  </p>

  <section
    class="demo"
    data-signals={`{offset: ${offset}}`}
    data-replace-url={`'/examples/pagination' + ($offset ? '?page=' + ($offset / ${LIMIT} + 1) : '')`}
  >
    <h2>Walks</h2>
    <PaginatedEntries offset={offset} />
    <pre><code>&lt;!-- page (?page=3 deep-links; replace-url keeps it in sync) --&gt;
&lt;section data-signals="&lbrace;offset: &lbrace;offset&rbrace;&rbrace;"
         data-replace-url="'/examples/pagination' + ($offset ? '?page=' + ($offset / 5 + 1) : '')"&gt;
  &lt;PaginatedEntries offset=&lbrace;offset&rbrace; /&gt;
&lt;/section&gt;

&lt;!-- PaginatedEntries.astro renders (offsets baked in server-side) --&gt;
&lt;div id="pagination"&gt;
  &lt;ul&gt;…page of entries…&lt;/ul&gt;
  &lt;button disabled=&lbrace;!hasPrev&rbrace;
          data-on:click="$offset = &lbrace;prevOffset&rbrace;; @get('/api/pagination')"&gt;« Previous&lt;/button&gt;
  &lt;p&gt;Page &lbrace;page&rbrace; of &lbrace;totalPages&rbrace;&lt;/p&gt;
  &lt;button disabled=&lbrace;!hasNext&rbrace;
          data-on:click="$offset = &lbrace;nextOffset&rbrace;; @get('/api/pagination')"&gt;Next »&lt;/button&gt;
&lt;/div&gt;

&lt;!-- endpoint --&gt;
const &lbrace; offset &rbrace; = await readSignals(request, signals); // zod-validated
return html(await container.renderToString(PaginatedEntries, &lbrace; props: &lbrace; offset &rbrace; &rbrace;));</code></pre>
    <PluginSource name="replace-url" />
  </section>
</Layout>
