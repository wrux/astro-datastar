---
import Layout from '../../layouts/Layout.astro';
import IndexGrid from '../../components/IndexGrid.astro';
import { nav } from '../../nav';

const examples = nav.find((g) => g.label === 'Examples')!;
const plugins = nav.find((g) => g.label === 'Plugin Examples')!;
---

<Layout title="Examples">
  <p>
    Every example is a live demo backed by real endpoints — each page shows
    the full source of the components and API routes it runs on.
  </p>
  <h2>Examples</h2>
  <IndexGrid items={examples.items} />
  <h2><a href="/examples/plugins">Plugin Examples</a></h2>
  <IndexGrid items={plugins.items} />
</Layout>
