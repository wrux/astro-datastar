{
  "name": "astro-datastar-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "overrides": {
    "@iconify/utils": "^3.1.4"
  },
  "scripts": {
    "dev": "npm run dev --workspace demo",
    "build": "npm run build --workspace demo",
    "preview": "npm run preview --workspace demo",
    "test": "npm test --workspace @wrux/astro-datastar",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7"
  }
}
