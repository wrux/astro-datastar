{
  "name": "astro-datastar-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "overrides": {
    "@iconify/utils": "^3.1.4"
  },
  "scripts": {
    "build:package": "npm run build --workspace @wrux/astro-datastar",
    "dev": "npm run build:package && npm run dev --workspace demo",
    "build": "npm run build:package && npm run build --workspace demo",
    "preview": "npm run preview --workspace demo"
  }
}
