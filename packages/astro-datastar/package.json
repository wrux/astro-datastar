{
  "name": "@wrux/astro-datastar",
  "version": "0.2.0",
  "type": "module",
  "description": "Astro integration for Datastar (vendored v1.0.2 bundle) implementing the Datastar SDK spec: ServerSentEventGenerator, readSignals, plus Astro endpoint helpers and a replace-url plugin",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-integration",
    "datastar",
    "hypermedia",
    "sse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrux/astro-datastar.git",
    "directory": "packages/astro-datastar"
  },
  "homepage": "https://github.com/wrux/astro-datastar#readme",
  "bugs": {
    "url": "https://github.com/wrux/astro-datastar/issues"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "default": "./dist/plugins/*.js"
    },
    "./loading.css": "./dist/loading.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/loading.css dist/loading.css",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sdk": "npm run build && node sdk-tests/run.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
